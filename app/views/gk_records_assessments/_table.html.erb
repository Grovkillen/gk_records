<%# The assessments of one thing, newest first. Each row holds the whole assessment: the values as they were, and
    beside a value that differs from the assessment before it, what it was then. compact: the tab on an issue. The
    table is GK GUI Stuff's. %>
<% ref = "#{@target_def.key}:#{@target.id}" %>
<%# the column where at least one assessment has the row (Verification.shown?), named by the assessments' place %>
<% verify = defined?(GkRecords::Verification) && @assessments.any? { |a| GkRecords::Verification.shown?(a) } %>
<div class="gk-records-assessments">
<% if @assessments.empty? %><p class="nodata"><%= l(:label_no_data) %></p><% else %>
<% columns = [{ key: :at, label: l(:label_gk_records_assessed_at), slot: :first, html: { class: 'assessed_at' } },
              { key: :name, label: l(:label_gk_records_assessment), slot: :grow, html: { class: 'name' } },
              { key: :outcome, label: l(:label_gk_records_outcome), slot: :end, html: { class: 'outcome' } },
              { key: :values, label: l(:label_gk_records_values), slot: :full, html: { class: 'text' } },
              { key: :user, label: l(:label_gk_records_done_by), html: { class: 'user' } }] %>
<% columns << { key: :verification, label: GkRecords::Verification.title('gk_records_assessment'), html: { class: 'verification gk-records-verification-cell' } } if verify %>
<%= gk_gui_stuff_table(columns: columns, html: { class: 'gk-records-assess-table' }) do %>
  <% @assessments.each do |a| %>
    <% was = a.changed_from_previous %>
    <%= gk_gui_stuff_table_row(html: { id: "gk-records-assessment-#{a.id}" }) do %>
      <%= gk_gui_stuff_table_cell(:at, gk_gui_stuff_quiet(format_time(a.assessed_at), nowrap: true)) %>
      <%= gk_gui_stuff_table_cell(:name, safe_join([a.display_title, gk_records_origin_badge(a.origin)])) %>
      <%= gk_gui_stuff_table_cell(:outcome, a.outcome.present? ? content_tag(:strong, a.outcome) : nil) %>
      <%= gk_gui_stuff_table_cell(:values) do %>
        <%# GK GUI Stuff's values in the mode now: the value that holds, what it was in the assessment before struck through after it %>
        <% values = a.values_list.map do |v|
             label, shown = gk_records_assess_pair(v['key'], v['label'], v['value'])
             row = { label: label, value: GkRecords::Ref.any?(shown) ? gk_records_value(shown, on: @target) : (shown.presence || '-') }
             if was.key?(v['key'])
               before = gk_records_assess_pair(v['key'], v['label'], was[v['key']]).last
               row[:was] = GkRecords::Ref.any?(before) ? gk_records_value(before, on: @target) : before
             end
             row
           end %>
        <%= gk_gui_stuff_values(values, mode: :now) %>
        <% if a.basis.present? %><%= gk_gui_stuff_quiet(safe_join(["#{l(:label_gk_records_basis)}: ", a.basis]), soft: true, tag: :div) %><% end %>
      <% end %>
      <%= gk_gui_stuff_table_cell(:user, gk_records_user(a.user, on: @target)) %>
      <% if verify %>
        <%= gk_gui_stuff_table_cell(:verification, GkRecords::Verification.shown?(a) ? (compact ? gk_records_verification_badge(a) : render(partial: 'gk_records/verification', locals: { obj: a, back_url: gk_records_assessments_page_path(target: ref, anchor: "gk-records-assessment-#{a.id}") })) : nil) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% end %>
<% if compact %><p><%= link_to l(:label_gk_records_open_as_page), gk_records_assessments_page_path(target: ref) %></p><% end %>
</div>
