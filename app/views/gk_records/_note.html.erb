<%# One note as GK GUI Stuff's entry: the head (the kind's pill, who, when, the number, where it came from and what it
    corrects, the actions at its end), the text, the quiet line under it and the answers as the entry's thread. A
    voided note is folded under who voided it, when and why; a corrected one has its text in the soft tone. The id
    gk-records-note-<id> is the note's anchor; the actions keep records' own classes for gk_records.js. %>
<% corrected_by = note.corrected_by.to_a %>
<% anchor = "gk-records-note-#{note.id}" %>
<% head = safe_join([gk_records_origin_badge(note.origin).presence,
                     *note.corrects.map { |c| gk_gui_stuff_quiet(safe_join([l(:text_gk_records_corrects), ' ', link_to("##{c.id}", "#gk-records-note-#{c.id}")]), soft: true) }].compact) %>
<% actions = nil %>
<% if editable && !note.voided? %>
  <%# Svara and Rätta are icon buttons with the word as the tooltip. Makulera is GK GUI Stuff's button with a reason
      from its icon alone, irreversible since a void cannot be undone: it always asks in its box in the role alarm,
      with the reason as the place records.note_void has it (Krävs, Valfritt, or none when Av) %>
  <% actions = capture do %>
    <%= gk_gui_stuff_icon_button('comment', l(:button_gk_records_reply), html: { class: 'gk-records-reply', data: { id: note.id } }) %>
    <% if note.user_id == User.current.id || User.current.admin? %>
      <%= gk_gui_stuff_icon_button('edit', l(:button_gk_records_correct), html: { class: 'gk-records-correct', data: { id: note.id } }) %>
      <%= gk_gui_stuff_reason_button(l(:button_gk_records_void), reason: 'records.note_void', url: gk_records_note_void_path(note),
                                     info: l(:text_gk_records_void_info), icon: 'del', icon_only: true, irreversible: true) %>
    <% end %>
  <% end %>
<% end %>
<%# voided: who, when and why are the heading the note is folded under %>
<% voided = nil %>
<% if note.voided? %>
  <% voided = capture do %><%= l(:text_gk_records_voided, user: GkRecords::Visibility.name_for(note.voided_by, system: ''), when: format_time(note.voided_at)) %><%= gk_records_restricted_mark(note.voided_by) %><% if note.void_reason %>: <%= note.void_reason.shown_body %><% end %><% end %>
<% end %>
<% under = corrected_by.any? ? safe_join([l(:text_gk_records_corrected_by), ' ', safe_join(corrected_by.map { |c| link_to("##{c.id}", "#gk-records-note-#{c.id}") }, ', ')]) : nil %>
<% replies = notes.select { |r| r.parent_id == note.id } %>
<% thread = replies.map { |r| render(partial: 'gk_records/note', locals: { note: r, notes: notes, editable: editable }) } %>
<%= gk_gui_stuff_entry(kind: gk_records_note_kind_tag(note.kind), who: gk_records_user(note.user, system: false, on: @target),
                       at: format_time(note.created_at), number: "##{note.id}", number_href: "##{anchor}", head: head.presence, actions: actions,
                       state: [note.voided? ? :voided : nil, corrected_by.any? ? :corrected : nil].compact, voided: voided,
                       under: under, thread: thread, id: anchor) do %>
  <%# A system text in the reader's language as it stood, and the text now when it has changed %>
  <%= gk_records_light(note.shown_body) %><%= gk_records_text_now(note.body_now) %>
<% end %>
