<%# gk_records: its settings, then Om pluginet and the change log %>
<% plugin = Redmine::Plugin.find(:gk_records) %>
<% changelog = ["CHANGELOG.#{current_language}.md", 'CHANGELOG.md'].map { |f| File.join(plugin.directory, f) }.find { |f| File.exist?(f) } %>
<fieldset class="box"><legend><%= l(:label_gk_records_about) %></legend>
  <div><strong><%= plugin.name %></strong> <%= plugin.version %></div>
  <div><%= l(:text_gk_records_description) %></div>
</fieldset>
<fieldset class="box tabular"><legend><%= l(:label_gk_records_settings_display) %></legend>
<p><label for="settings_note_max_length"><%= l(:field_gk_records_note_max_length) %></label>
  <%= number_field_tag 'settings[note_max_length]', GkRecordsNote.max_length, id: 'settings_note_max_length', min: 100, max: 20000 %></p>
<p><label for="settings_show_origin_badge"><%= l(:field_gk_records_show_origin_badge) %></label>
  <%= hidden_field_tag 'settings[show_origin_badge]', '0', id: nil %>
  <%= check_box_tag 'settings[show_origin_badge]', '1', settings['show_origin_badge'].to_s == '1', id: 'settings_show_origin_badge' %>
  <em class="info"><%= l(:text_gk_records_show_origin_badge) %></em></p>
<p><label for="settings_mark_restricted_people"><%= l(:field_gk_records_mark_restricted_people) %></label>
  <%= hidden_field_tag 'settings[mark_restricted_people]', '0', id: nil %>
  <%= check_box_tag 'settings[mark_restricted_people]', '1', settings['mark_restricted_people'].to_s != '0', id: 'settings_mark_restricted_people' %>
  <%# where it is decided: core's role setting, with the way there (records_1021-SID-58, 63, 70) %>
  <em class="info"><%= l(:text_gk_records_mark_restricted_people, setting: content_tag('strong', l(:field_users_visibility)),
                          roles: link_to(l(:label_role_and_permissions), roles_path), members: l(:label_users_visibility_members_of_visible_projects)).html_safe %></em></p>
<%# the number on the tabs Kopplingar and Bedömningar, for the whole installation (records_1021-SID-19) %>
<p><label for="settings_tab_counts"><%= l(:field_gk_records_tab_counts) %></label>
  <%= hidden_field_tag 'settings[tab_counts]', '0', id: nil %>
  <%= check_box_tag 'settings[tab_counts]', '1', settings['tab_counts'].to_s == '1', id: 'settings_tab_counts' %>
  <em class="info"><%= l(:text_gk_records_tab_counts) %></em></p>
</fieldset>
<%# The functions (GkRecords::Features): each with its switch, what it is for, and who turns it on or would use it
    (records_1021, ALLMÄNT); off hides the pages, the menu rows and the tabs, and keeps what is kept %>
<% f = GkRecords::Features %>
<% features = settings['features'].is_a?(Hash) ? settings['features'] : {} %>
<fieldset class="box tabular"><legend><%= l(:label_gk_records_features) %></legend>
<p class="info"><%= l(:text_gk_records_features) %></p>
<% f::SWITCHED.each do |k| %>
  <% by = f.turned_on_by(k) %>
  <p><label for="settings_features_<%= k %>"><%= l("label_gk_records_feature_#{k}") %></label>
    <%= hidden_field_tag "settings[features][#{k}]", (by.any? ? features[k].to_s.presence || '0' : '0'), id: nil %>
    <%= check_box_tag "settings[features][#{k}]", '1', by.any? || features[k].to_s == '1', id: "settings_features_#{k}", disabled: by.any? %>
    <em class="info"><%= l("text_gk_records_feature_#{k}") %>
      <% if by.any? %><br><%= l(:text_gk_records_feature_on_by, plugins: by.map { |p| f.name_of(p) }.join(', ')) %>
      <% elsif (gone = f.missing_users(k)).any? %><br><%= l(:text_gk_records_feature_unused, plugins: gone.map { |p| f.name_of(p) }.join(', ')) %><% end %></em></p>
<% end %>
<%# Verification status: on when a tracker has it, chosen on the tracker's own page (records_1021-SID-28); its name from
    the locales (records_1021-SID-56: renaming belongs to a fields plugin later) %>
<% v = GkRecords::Verification %>
<p><label><%= l(:label_gk_records_feature_verification) %></label>
  <%# the trackers' names stand out from the sentence (records_1021-SID-69) %>
  <span><%= v.tracker_ids.any? ? l(:text_gk_records_verification_on_trackers, trackers: safe_join(Tracker.where(id: v.tracker_ids).sorted.map { |t| content_tag('strong', t.name) }, ', ')).html_safe : l(:text_gk_records_verification_off) %>
    <%= link_to l(:label_tracker_plural), trackers_path %></span>
  <em class="info"><%= l(v.reviewer ? :text_gk_records_feature_verification_review : :text_gk_records_feature_verification) %></em></p>
<%= hidden_field_tag 'settings[verification_tracker_ids][]', '', id: nil %>
<% v.tracker_ids.each do |id| %><%= hidden_field_tag 'settings[verification_tracker_ids][]', id, id: nil %><% end %>
</fieldset>
<%# The assessment kinds that are data (GkRecords::AssessmentKinds), carried unchanged by this form; their box only when
    there are some %>
<%= hidden_field_tag 'settings[assessment_kinds]', settings['assessment_kinds'].to_s, id: nil %>
<% data_kinds = GkRecords::AssessmentKinds.all %>
<% if data_kinds.any? %>
<fieldset class="box tabular"><legend><%= l(:label_gk_records_assessment_kinds_data) %></legend>
<p><label><%= l(:label_gk_records_assessment_kinds_data) %></label>
  <span><%= safe_join(data_kinds.map { |k| k.scale.present? ? "#{k.label} (#{k.scale.map { |v| k.scale_label(v['key']) }.join(', ')})" : k.label }, '; ') %></span>
  <em class="info"><%= l(:text_gk_records_assessment_kinds_data) %></em></p>
</fieldset>
<% end %>
<%# The registered targets as core's list: one row per sort of thing, who registered it and which event and link kinds
    may be used on it, so that what is a target is seen at once (icons_1025-SID-24) %>
<%# The cells give the number of kinds, their names in the tooltip; the link kinds that go on every target are named
    once under the list instead of on every row %>
<% kinds = GkRecords::Kinds.all.values %>
<% link_kinds = kinds.select { |k| k.scope.to_s == 'link' } %>
<% everywhere = link_kinds.select { |k| k.targets.nil? && k.sources.nil? } %>
<fieldset class="box"><legend><%= l(:label_gk_records_registered) %></legend>
<p class="info"><%= l(:text_gk_records_registered) %></p>
<div class="autoscroll">
<table class="list gk-records-targets">
  <thead><tr>
    <th><%= l(:field_gk_records_target_thing) %></th>
    <th><%= l(:field_gk_records_target_key) %></th>
    <th><%= l(:field_gk_records_target_plugin) %></th>
    <th><%= l(:field_gk_records_target_events) %></th>
    <th><%= l(:field_gk_records_target_links) %></th>
  </tr></thead>
  <tbody>
  <% GkRecords::Targets.all.values.sort_by { |t| GkRecords::Targets.thing_label(t.key).to_s.downcase }.each do |t| %>
    <% events = kinds.select { |k| k.scope.to_s == 'event' && k.target.to_s == t.key }.map(&:label).sort %>
    <% links = (link_kinds - everywhere).select { |k| k.offered_on?(t.key) || k.allows?(t.key) }.map(&:label).sort %>
    <% owner = GkRecords::Targets.owner(t.key) %>
    <tr>
      <td class="name"><%= GkRecords::Targets.thing_label(t.key) %></td>
      <td class="key"><code><%= t.key %></code></td>
      <td class="plugin"><%= owner ? owner.name : '-' %></td>
      <td class="events"><%= events.any? ? content_tag('span', events.size, title: events.join(', ')) : '-' %></td>
      <td class="links"><%= links.any? ? content_tag('span', links.size, title: links.join(', ')) : '-' %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% if everywhere.any? %>
<p class="info"><%= l(:text_gk_records_registered_links_everywhere, kinds: everywhere.map(&:label).sort.join(', ')) %></p>
<% end %>
</fieldset>
<% if changelog %>
<fieldset class="box"><legend><%= l(:label_gk_records_changelog) %></legend>
  <% unless current_language.to_s.start_with?('en') %><div class="gk-changelog-note"><em><%= l(:text_gk_records_changelog_english) %></em></div><% end %>
  <details class="gk-changelog"><summary><%= l(:button_show) %></summary>
  <div class="wiki"><%= Redmine::WikiFormatting.to_html('common_mark', File.read(changelog, encoding: 'UTF-8').sub(/\A.*?(?=^## )/m, '')).html_safe %></div>
  </details>
</fieldset>
<% end %>
